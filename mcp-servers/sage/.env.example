# ---------- Sage Intacct (XML gateway) ----------
# Obtain sender credentials from Intacct Company > Setup > Company > Subscriptions > Web Services.
# User credentials are for a Web Services user you create in the company.
INTACCT_SENDER_ID=
INTACCT_SENDER_PASSWORD=
INTACCT_COMPANY_ID=
INTACCT_USER_ID=
INTACCT_USER_PASSWORD=
# Optional: pin a specific entity in a multi-entity shared environment.
INTACCT_ENTITY_ID=
# Gateway URL rarely changes; override only if Sage tells you to.
INTACCT_ENDPOINT=https://api.intacct.com/ia/xml/xmlgw.phtml

# ---------- Sage Construction Management (REST) ----------
# Base URL for your SCM tenant's REST API. Get this from the SCM developer portal
# or your account rep — it differs per region/tenant.
SAGECM_BASE_URL=
# Preferred: OAuth2 client-credentials. Fill these if your tenant issues them.
SAGECM_CLIENT_ID=
SAGECM_CLIENT_SECRET=
SAGECM_TOKEN_URL=
# Fallback: static API key / bearer token if your tenant uses one.
SAGECM_API_KEY=
